# MongoDB (Atlas free tier works fine). RSVPs are saved to <MONGODB_DB>.rsvps
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=wedding

# Lets you view responses at /api/rsvp?key=YOUR_KEY
RSVP_ADMIN_KEY=

# Optional: also forward every RSVP to a webhook (Google Apps Script, Zapier, Make, etc.)
RSVP_WEBHOOK_URL=
